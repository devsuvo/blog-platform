# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
# Required in production — see config/settings/production.py.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# Canonical domain used for SEO (canonical/OG/JSON-LD URLs) — Step 5.
SITE_URL=https://example.com

# --- Database -------------------------------------------------------------
# Local dev may leave this unset to fall back to SQLite.
# Production: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://user:password@localhost:5432/blog

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# --- Cache ---------------------------------------------------------
# Bump CACHE_VERSION to invalidate every cache key at once after a change
# to what a key's shape/contents mean (see apps/core/cache.py). TTLs are
# per-resource seconds; the defaults in config/settings/base.py are sane —
# only override if you've measured a reason to.
# CACHE_VERSION=v1
# CACHE_TTL_SITE_SETTINGS=3600
# CACHE_TTL_HOMEPAGE=120
# CACHE_TTL_LISTING=300
# CACHE_TTL_POST_CONTENT=3600
# CACHE_TTL_SITEMAP=1800
# CACHE_TTL_RSS=600

# --- Email ---------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Misc ---------------------------------------------------------
TIME_ZONE=UTC

# --- Public site identity ---------------------------------------------------
SITE_NAME=The Blog Platform
SITE_DESCRIPTION=Ideas, tutorials, and insights for modern developers.
CONTACT_EMAIL=hello@example.com

# --- Production-only security overrides (sane defaults already set in code) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
