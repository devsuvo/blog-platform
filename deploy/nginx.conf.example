# Example Nginx site config — adjust paths/domain, then symlink into
# /etc/nginx/sites-enabled/ (or the equivalent for your distro). Terminates
# HTTPS, serves static/media directly (never proxied to Gunicorn — that's
# pure I/O Django doesn't need to spend a worker on), and forwards
# everything else to Gunicorn over a Unix socket.
#
# Replace:
#   example.com                 -> your real domain(s)
#   /srv/blog-platform           -> the project's deployed path
#   /run/gunicorn-blog.sock      -> match the socket Gunicorn binds to

# Plain HTTP: redirect to HTTPS. No other behavior here — an app-level
# redirect loop is what SECURE_SSL_REDIRECT + SECURE_PROXY_SSL_HEADER
# guard against (see config/settings/production.py); Nginx doing the
# redirect at this layer means Django never even sees the HTTP request.
server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.com www.example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Belt-and-suspenders alongside Django's own SECURE_* settings —
    # if Django is ever bypassed (a misconfigured proxy, a static file),
    # these still apply.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    client_max_body_size 10M;  # generous enough for the 5MB inline-image cap plus form overhead

    # --- Static & media: served directly, never proxied to Gunicorn ---
    # STATIC_ROOT / MEDIA_ROOT from config/settings/base.py.
    location /static/ {
        alias /srv/blog-platform/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /srv/blog-platform/media/;
        expires 7d;
        # Media is untrusted, user-supplied content — never let the web
        # server execute it as a script under any circumstance.
        location ~ \.(php|py|pl|sh|cgi)$ { deny all; }
    }

    # Never serve the repo's own dotfiles/VCS directory even if a deploy
    # mistake puts them inside the web root.
    location ~ /\.(env|git) {
        deny all;
    }

    # --- Everything else -> Gunicorn ---
    location / {
        proxy_pass http://unix:/run/gunicorn-blog.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Required: this is what SECURE_PROXY_SSL_HEADER in production.py
        # reads to know the original request was HTTPS, even though the
        # Gunicorn-facing connection itself is plain HTTP over the socket.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    # gzip for text-ish responses; media/static are already compressed
    # formats or served with far-future cache headers, so they're
    # excluded rather than spending CPU compressing them per-request.
    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/xml text/xml application/rss+xml;
    gzip_min_length 512;
}
